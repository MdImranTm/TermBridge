{
  "name": "termbridge",
  "version": "1.2.1",
  "description": "Professional Windows AI coding workspace with interactive PTY terminal, automatic engine boot, reliable settings controls, runtime capability discovery, and validated UI interactions.",
  "main": "main.js",
  "author": "MdImranTm",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "cross-spawn": "^7.0.6",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "@electron/asar": "3.4.1"
  },
  "build": {
    "appId": "com.termbridge.desktop",
    "productName": "TermBridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TermBridge",
      "runAfterFinish": true,
      "artifactName": "TermBridge-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "TermBridge-${version}-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
